<%- include('partials/header') %>

<!-- ============================================================
     PAGE HEADING
     ============================================================ -->
<section class="page-heading">
  <div class="container">
    <h1 class="page-title">About Me</h1>
    <p class="page-subtitle">A little about who I am and what I'm working toward.</p>
  </div>
</section>

<!-- ============================================================
     PROFILE — legal name, photo, and short bio
     ============================================================ -->
<section class="section">
  <div class="container">
    <div class="row g-5 align-items-start">
      <div class="col-lg-4">
        <div class="profile-card">
          <img src="/images/avatar.png" alt="Shu Haoyang (Jackie) headshot" class="profile-photo" />
          <h2 class="profile-name">Shu Haoyang</h2>
          <p class="profile-ename">(Jackie)</p>
          <p class="profile-meta">Suzhou Centennial College</p>
          <p class="profile-meta">Software Technology · Class of 2027</p>
          <a href="/resume/ShuHaoyang_Resume.pdf" class="btn btn-accent w-100 mt-2" download>
            <i class="bi bi-file-earmark-pdf me-2"></i>Download Resume (PDF)
          </a>
        </div>
      </div>

      <div class="col-lg-8">
        <div class="bio">
          <h3 class="bio-heading">Who I am</h3>
          <p>
            I'm a Software Technology student at Suzhou Centennial College with a
            growing foundation in programming (C, C#, Java), SQL databases and
            Linux. Alongside my technical coursework, I've spent real time in
            customer-facing roles — from tutoring and teaching assistance to
            part-time barista work and bilingual event support.
          </p>
          <p>
            That mix is deliberate: I'm working toward a career in
            <strong>technical sales, FAE or technical support</strong>, where I can
            pair technical understanding with clear, patient communication. I enjoy
            translating complex ideas into plain language and helping people get the
            most out of technology.
          </p>
          <p>
            Outside the classroom I've earned awards in web design and English
            public speaking, and I keep myself busy balancing study, competitions
            and part-time work — which has built strong self-learning and
            time-management habits.
          </p>
        </div>

        <h3 class="bio-heading mt-5">Core Skills</h3>
        <div class="skill-row">
          <span class="skill-chip">C</span>
          <span class="skill-chip">C#</span>
          <span class="skill-chip">Java</span>
          <span class="skill-chip">SQL</span>
          <span class="skill-chip">Linux</span>
          <span class="skill-chip">HTML &amp; CSS</span>
          <span class="skill-chip">JavaScript</span>
          <span class="skill-chip">Node.js / Express</span>
          <span class="skill-chip">Bilingual (EN / 中文)</span>
        </div>
      </div>
    </div>
  </div>
</section>

