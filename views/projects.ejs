<%- include('partials/header') %>

<!-- ============================================================
     PAGE HEADING
     ============================================================ -->
<section class="page-heading">
  <div class="container">
    <h1 class="page-title">Projects</h1>
    <p class="page-subtitle">Selected work I'm proud to share.</p>
  </div>
</section>

<!-- ============================================================
     PROJECT LIST — one card per highlighted project
     ============================================================ -->
<section class="section">
  <div class="container">
    <div class="row g-4">
      <% projects.forEach(function (project) { %>
      <div class="col-md-6 col-lg-4">
        <article class="card project-card h-100">
          <img src="<%= project.image %>" alt="<%= project.title %>" class="card-img-top project-image" />
          <div class="card-body d-flex flex-column">
            <span class="project-category"><%= project.category %></span>
            <h3 class="project-title"><%= project.title %></h3>
            <p class="project-role"><i class="bi bi-person-badge me-1"></i><%= project.role %></p>
            <p class="project-desc"><%= project.description %></p>
            <p class="project-outcome mt-auto">
              <i class="bi bi-trophy me-1"></i><%= project.outcome %>
            </p>
          </div>
        </article>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
