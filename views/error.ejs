<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Error — Jackie Shu</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet" />
  <link rel="stylesheet" href="/stylesheets/style.css" />
</head>
<body class="error-body">
  <div class="container error-wrap">
    <div class="error-code"><%= error.status || 500 %></div>
    <h1 class="error-title"><%= message %></h1>
    <p class="error-text">Something went wrong. Head back to the home page and try again.</p>
    <a href="/" class="btn btn-accent btn-lg">Back to Home</a>
    <% if (error.stack) { %>
    <pre class="error-stack"><%= error.stack %></pre>
    <% } %>
  </div>
</body>
</html>
